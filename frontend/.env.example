# Copy this file to .env and fill in your values.
# VITE_ prefix is required — Vite only exposes variables with this prefix to the browser.
# These values are embedded in the built JS and are publicly visible — do not put secrets here.

VITE_BOARD_CONTRACT_ID=autobattleboard.testnet
VITE_BATTLE_CONTRACT_ID=autobattlebattle.testnet
VITE_NETWORK_ID=testnet
